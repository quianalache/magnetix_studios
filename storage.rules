rules_version = '2';

// Firebase Storage rules. Writer surfaces: Community's group cover/logo/
// lesson uploads, and Standalone Courses' cover/lesson uploads (+ rehosted
// Skool lesson-resource PDFs, Admin-SDK-written only — see that match
// block's own comment). Both are PUBLIC reads (the /c/* and /course/*
// pages are public), writes require a signed-in Firebase user (staff —
// members/buyers are NOT Firebase users, so they can't write here) plus an
// image (or, standalone-courses only, PDF) content-type + 5 MB size cap.
//
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Broadcast composer image/video-thumbnail uploads. `allow read: if true`
    // is structurally required here (not just a rubber-stamp copy) — these
    // URLs get embedded in outbound email, fetched by third-party mail
    // clients with no Firebase session at all.
    match /broadcasts/{subAccountId}/{draftId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Agency Communications composer image/video-thumbnail uploads — the
    // agency-scope sibling of the rule above. Real write/delete path is
    // Admin-SDK-only (see /api/agency/communications/upload); kept for
    // parity/defense-in-depth only. `allow read: if true` for the same
    // structural reason — third-party mail clients fetch these with no
    // Firebase session.
    match /broadcasts/agency/{agencyId}/{draftId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Community group cover/logo images.
    match /community/{subAccountId}/{groupId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Agency Community group cover/logo/favicon images — the agency-scope
    // sibling of the rule above, rooted at a literal "agency" segment
    // (never a real subAccountId) so the two ownership scopes can never
    // collide. Public read for the same reason (the About page renders
    // publicly). The real write/delete path is Admin-SDK-only (the agency
    // owner has no Firebase-Storage-writable client identity here, and a
    // Community member is never a Firebase user at all — see
    // /api/agency/community/[groupId]/settings/upload), which bypasses
    // this rule regardless; kept for parity/defense-in-depth only.
    match /community/agency/{agencyId}/{groupId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Standalone Course cover/lesson images — same rules, independent path
    // (no groupId; standalone courses have no group). Also where the Skool
    // course-media migration's rehosted lesson PDFs live (2026-09-12,
    // `skool-import-resource-{fileId}.pdf` — same path prefix, uploaded via
    // Admin SDK, which isn't subject to this rule's write clause at all;
    // `application/pdf` is allowed here too so this rule stays an honest
    // description of what's actually stored, and so a future CLIENT
    // uploader for a lesson resource wouldn't need a second rule).
    match /standalone-courses/{subAccountId}/{courseId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // Agency Standalone Course cover/lesson images — the agency-scope
    // sibling of the rule above, rooted at a literal "agency" segment
    // (never a real subAccountId), same convention as the Community
    // rule's own agency sibling. The real write/delete path is Admin-SDK-
    // only (see /api/agency/standalone-courses/[courseId]/upload); kept
    // for parity/defense-in-depth only.
    match /standalone-courses/agency/{agencyId}/{courseId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Course Offer thumbnail images — same rules, independent path.
    match /course-offers/{subAccountId}/{offerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Agency Course Offer thumbnail/theme images — agency sibling of the
    // rule above. Real write/delete path is Admin-SDK-only (see
    // /api/agency/course-offers/[offerId]/upload); kept for parity only.
    match /course-offers/agency/{agencyId}/{offerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Form Design panel background/header images — same rules, independent
    // path. Public read: the hosted /f/[formId] page and iframe embeds are
    // both public, no session.
    match /forms/{subAccountId}/{formId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Pages & Funnels Image element uploads (real user QA blocker — the
    // Image element previously only accepted a raw pasted URL) — same
    // rules, independent path. Public read: a published Puck page
    // (`/p/[pageId]`) is a public route, fetched by visitors with no
    // Firebase session at all, same rationale as every match block above.
    match /pages-funnels/{subAccountId}/{pageId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Media Library direct uploads (Assets corrections, 2026-09-29). Files
    // too large for the app server's request cap go browser → Storage into
    // a per-person intake folder. CREATE only — no read, overwrite or
    // delete — only into the signed-in person's own {uid} folder, capped at
    // the Media Library's document limit, allowed types only. Nothing here
    // is served: the server validates the object against its intake record,
    // moves it to the private media-library/ path and deletes it.
    match /media-uploads/{uid}/{intakeId}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(image/(jpeg|png|webp|gif)|application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet|presentationml[.]presentation)|application/vnd[.]ms-(excel|powerpoint)|text/(csv|plain))$'
        );
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
