rules_version = '2';

// Firebase Storage rules. Writer surfaces: Community's group cover/logo/
// lesson uploads, and Standalone Courses' cover/lesson uploads. Both are
// PUBLIC reads (the /c/* and /course/* pages are public), writes require a
// signed-in Firebase user (staff — members/buyers are NOT Firebase users, so
// they can't write here) plus an image content-type + 5 MB size cap.
//
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Community group cover/logo images.
    match /community/{subAccountId}/{groupId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Standalone Course cover/lesson images — same rules, independent path
    // (no groupId; standalone courses have no group).
    match /standalone-courses/{subAccountId}/{courseId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Course Offer thumbnail images — same rules, independent path.
    match /course-offers/{subAccountId}/{offerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
