rules_version = '2';

// Firebase Storage rules. Browser uploads (staff only — community members,
// students and buyers are not Firebase users) go to Pages & Funnels, Broadcast,
// Community, Standalone Course, Course Offer, Form, Content Library and QR Code
// folders. Since the
// 2026-11-16 hardening each folder allows only CREATE of a new file, only by a
// verified account with the right role in the workspace that owns the folder
// (checked against Firestore membership + the owning record); no browser
// overwrite or delete. Agency-scope folders are written only by Admin-SDK
// server routes. Public reads are unchanged (pages, emails, courses and forms
// are viewed by people with no Firebase session).
//
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Page Builder image uploads (2026-11-16): mirrors Firestore's canAdminSub
    // for the workspace that owns the page. Cross-service reads (firestore.get
    // / firestore.exists) — the same membership records the Firestore rules use.
    function canAddPageAsset(subAccountId, pageId) {
      return request.auth != null
        && request.auth.token.status == "active"
        && firestore.exists(/databases/(default)/documents/pages/$(pageId))
        && firestore.get(/databases/(default)/documents/pages/$(pageId)).data.subAccountId == subAccountId
        && (
          (request.auth.token.agencyRole == "owner"
            && request.auth.token.agencyId == firestore.get(/databases/(default)/documents/subAccounts/$(subAccountId)).data.agencyId)
          || (firestore.exists(/databases/(default)/documents/subAccounts/$(subAccountId)/subAccountMembers/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/subAccounts/$(subAccountId)/subAccountMembers/$(request.auth.uid)).data.status == "active"
            && firestore.get(/databases/(default)/documents/subAccounts/$(subAccountId)/subAccountMembers/$(request.auth.uid)).data.role == "admin")
        );
    }

    // ── Wave 2 Storage hardening (2026-11-16) ─────────────────────────────
    // Same model as canAddPageAsset, per module. The identity comes from the
    // verified token; workspace membership, role and the owning record come
    // from Firestore — never from the path alone. Each check reads at most
    // two distinct documents (the cross-service limit per evaluation).
    function activeUser() {
      return request.auth != null && request.auth.token.status == "active";
    }
    function memberPath(subAccountId) {
      return /databases/(default)/documents/subAccounts/$(subAccountId)/subAccountMembers/$(request.auth.uid);
    }
    function isActiveMember(subAccountId) {
      return firestore.exists(memberPath(subAccountId))
        && firestore.get(memberPath(subAccountId)).data.status == "active";
    }
    function isActiveAdmin(subAccountId) {
      return isActiveMember(subAccountId)
        && firestore.get(memberPath(subAccountId)).data.role == "admin";
    }
    function ownsWorkspaceAgency(subAccountId) {
      return request.auth.token.agencyRole == "owner"
        && request.auth.token.agencyId == firestore.get(/databases/(default)/documents/subAccounts/$(subAccountId)).data.agencyId;
    }
    // A record kept under the workspace (communityGroups / standaloneCourses / courseOffers).
    function canAddWorkspaceRecordAsset(subAccountId, collection, recordId) {
      return activeUser()
        && firestore.exists(/databases/(default)/documents/subAccounts/$(subAccountId)/$(collection)/$(recordId))
        && (ownsWorkspaceAgency(subAccountId) || isActiveAdmin(subAccountId));
    }
    // Broadcast composer images: any active member may send broadcasts, so any
    // active member (or the agency owner) may add images for that workspace.
    function canAddBroadcastAsset(subAccountId) {
      return activeUser()
        && (ownsWorkspaceAgency(subAccountId) || isActiveMember(subAccountId));
    }
    // Content Library + QR Codes (2026-11-17 repair — these folders had no
    // rule, so every browser upload failed). Same model: staff of the workspace
    // with the edit role the records already require (admin or agency owner,
    // matching firestore.rules for contentTemplates / qrCodes).
    function isWorkspaceEditor(subAccountId) {
      return ownsWorkspaceAgency(subAccountId) || isActiveAdmin(subAccountId);
    }
    function isWorkspaceStaff(subAccountId) {
      return activeUser() && (ownsWorkspaceAgency(subAccountId) || isActiveMember(subAccountId));
    }
    // A saved template must be this workspace's; an unsaved one uploads to the
    // fixed "draft-template" folder (the dialog's own convention).
    function canAddContentLibraryAsset(subAccountId, docId) {
      return activeUser()
        && (docId == "draft-template"
          || (firestore.exists(/databases/(default)/documents/contentTemplates/$(docId))
            && firestore.get(/databases/(default)/documents/contentTemplates/$(docId)).data.subAccountId == subAccountId))
        && isWorkspaceEditor(subAccountId);
    }
    // A saved QR code must be this workspace's; the New QR code page uploads
    // before the record exists, into a random UUID folder (real QR ids are
    // 20-character Firestore ids, never UUID-shaped).
    function canAddQrAsset(subAccountId, qrId) {
      return activeUser()
        && (qrId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          || (firestore.exists(/databases/(default)/documents/qrCodes/$(qrId))
            && firestore.get(/databases/(default)/documents/qrCodes/$(qrId)).data.subAccountId == subAccountId))
        && isWorkspaceEditor(subAccountId);
    }

    // Forms are top-level records that name their workspace.
    function canAddFormAsset(subAccountId, formId) {
      return activeUser()
        && firestore.exists(/databases/(default)/documents/forms/$(formId))
        && firestore.get(/databases/(default)/documents/forms/$(formId)).data.subAccountId == subAccountId
        && (
          (request.auth.token.agencyRole == "owner"
            && request.auth.token.agencyId == firestore.get(/databases/(default)/documents/forms/$(formId)).data.agencyId)
          || isActiveAdmin(subAccountId)
        );
    }

    // Broadcast composer image/video-thumbnail uploads. `allow read: if true`
    // is structurally required here (not just a rubber-stamp copy) — these
    // URLs get embedded in outbound email, fetched by third-party mail
    // clients with no Firebase session at all.
    match /broadcasts/{subAccountId}/{draftId}/{fileName} {
      allow read: if true;
      allow create: if canAddBroadcastAsset(subAccountId)
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Agency Communications composer image/video-thumbnail uploads — the
    // agency-scope sibling of the rule above. Real write/delete path is
    // Admin-SDK-only (see /api/agency/communications/upload); kept for
    // parity/defense-in-depth only. `allow read: if true` for the same
    // structural reason — third-party mail clients fetch these with no
    // Firebase session.
    match /broadcasts/agency/{agencyId}/{draftId}/{fileName} {
      allow read: if true;
      // Uploaded only by Admin-SDK server routes (which bypass these rules);
      // the browser never writes here (2026-11-16 hardening — previously any
      // signed-in account could).
      allow write: if false;
    }

    // Community group cover/logo images.
    match /community/{subAccountId}/{groupId}/{fileName} {
      allow read: if true;
      allow create: if canAddWorkspaceRecordAsset(subAccountId, "communityGroups", groupId)
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Agency Community group cover/logo/favicon images — the agency-scope
    // sibling of the rule above, rooted at a literal "agency" segment
    // (never a real subAccountId) so the two ownership scopes can never
    // collide. Public read for the same reason (the About page renders
    // publicly). The real write/delete path is Admin-SDK-only (the agency
    // owner has no Firebase-Storage-writable client identity here, and a
    // Community member is never a Firebase user at all — see
    // /api/agency/community/[groupId]/settings/upload), which bypasses
    // this rule regardless; kept for parity/defense-in-depth only.
    match /community/agency/{agencyId}/{groupId}/{fileName} {
      allow read: if true;
      // Uploaded only by Admin-SDK server routes (which bypass these rules);
      // the browser never writes here (2026-11-16 hardening — previously any
      // signed-in account could).
      allow write: if false;
    }

    // Standalone Course cover/lesson images — same rules, independent path
    // (no groupId; standalone courses have no group). Also where the Skool
    // course-media migration's rehosted lesson PDFs live (2026-09-12,
    // `skool-import-resource-{fileId}.pdf` — same path prefix, uploaded via
    // Admin SDK, which isn't subject to this rule's write clause at all;
    // `application/pdf` is allowed here too so this rule stays an honest
    // description of what's actually stored, and so a future CLIENT
    // uploader for a lesson resource wouldn't need a second rule).
    match /standalone-courses/{subAccountId}/{courseId}/{fileName} {
      allow read: if true;
      allow create: if canAddWorkspaceRecordAsset(subAccountId, "standaloneCourses", courseId)
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    // Agency Standalone Course cover/lesson images — the agency-scope
    // sibling of the rule above, rooted at a literal "agency" segment
    // (never a real subAccountId), same convention as the Community
    // rule's own agency sibling. The real write/delete path is Admin-SDK-
    // only (see /api/agency/standalone-courses/[courseId]/upload); kept
    // for parity/defense-in-depth only.
    match /standalone-courses/agency/{agencyId}/{courseId}/{fileName} {
      allow read: if true;
      // Uploaded only by Admin-SDK server routes (which bypass these rules);
      // the browser never writes here (2026-11-16 hardening — previously any
      // signed-in account could).
      allow write: if false;
    }

    // Course Offer thumbnail images — same rules, independent path.
    match /course-offers/{subAccountId}/{offerId}/{fileName} {
      allow read: if true;
      allow create: if canAddWorkspaceRecordAsset(subAccountId, "courseOffers", offerId)
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Agency Course Offer thumbnail/theme images — agency sibling of the
    // rule above. Real write/delete path is Admin-SDK-only (see
    // /api/agency/course-offers/[offerId]/upload); kept for parity only.
    match /course-offers/agency/{agencyId}/{offerId}/{fileName} {
      allow read: if true;
      // Uploaded only by Admin-SDK server routes (which bypass these rules);
      // the browser never writes here (2026-11-16 hardening — previously any
      // signed-in account could).
      allow write: if false;
    }

    // Form Design panel background/header images — same rules, independent
    // path. Public read: the hosted /f/[formId] page and iframe embeds are
    // both public, no session.
    match /forms/{subAccountId}/{formId}/{fileName} {
      allow read: if true;
      allow create: if canAddFormAsset(subAccountId, formId)
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Pages & Funnels Image element uploads (real user QA blocker — the
    // Image element previously only accepted a raw pasted URL) — same
    // rules, independent path. Public read: a published Puck page
    // (`/p/[pageId]`) is a public route, fetched by visitors with no
    // Firebase session at all, same rationale as every match block above.
    //
    // Security hardening (2026-11-16): any signed-in account used to be able
    // to upload into, overwrite or delete ANY workspace's page folder. Now:
    // only an active agency owner of the workspace's agency, or an active
    // admin of that workspace, may ADD a file, and only into the folder of a
    // page that really belongs to that workspace (read from Firestore — the
    // path's ids are never trusted on their own). The builder only ever adds
    // new, uniquely named files, so overwriting and deleting from the browser
    // are not allowed at all. Server jobs use the Admin SDK and other folders.
    match /pages-funnels/{subAccountId}/{pageId}/{fileName} {
      allow read: if true;
      allow create: if canAddPageAsset(subAccountId, pageId)
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Content Library template-description images (2026-11-17 repair).
    // Read: staff of the workspace only (the app reads the download link
    // right after upload; the links it stores keep working as before).
    match /content-library/{subAccountId}/{docId}/{fileName} {
      allow read: if isWorkspaceStaff(subAccountId);
      allow create: if canAddContentLibraryAsset(subAccountId, docId)
        && resource == null
        && fileName.matches('image-.*')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // QR Code logo (≤ 2 MB) and background (≤ 5 MB) images (2026-11-17 repair).
    match /qr-codes/{subAccountId}/{qrId}/{fileName} {
      allow read: if isWorkspaceStaff(subAccountId);
      allow create: if canAddQrAsset(subAccountId, qrId)
        && resource == null
        && request.resource.contentType.matches('image/.*')
        && (
          (fileName.matches('logo-.*') && request.resource.size < 2 * 1024 * 1024)
          || (fileName.matches('background-.*') && request.resource.size < 5 * 1024 * 1024)
        );
      allow update, delete: if false;
    }

    // Media Library direct uploads (Assets corrections, 2026-09-29). Files
    // too large for the app server's request cap go browser → Storage into
    // a per-person intake folder. CREATE only — no read, overwrite or
    // delete — only into the signed-in person's own {uid} folder, capped at
    // the Media Library's document limit, allowed types only (audio added
    // for the page builder's Audio block, Wave 3). Nothing here
    // is served: the server validates the object against its intake record,
    // moves it to the private media-library/ path and deletes it.
    match /media-uploads/{uid}/{intakeId}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches(
          '^(image/(jpeg|png|webp|gif)|audio/(mpeg|mp4|x-m4a|aac|wav|x-wav|ogg|webm)|application/pdf|application/msword|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet|presentationml[.]presentation)|application/vnd[.]ms-(excel|powerpoint)|text/(csv|plain))$'
        );
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
